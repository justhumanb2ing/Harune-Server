{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "server",
	"main": "src/index.ts",
	"compatibility_date": "2026-05-07",
	"workers_dev": true,
	"observability": {
		"enabled": true,
		"head_sampling_rate": 0.1,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 0.1,
			"persist": true,
			"invocation_logs": true
		},
		"traces": {
			"enabled": true,
			"persist": true,
			"head_sampling_rate": 0.1
		}
	},
	"routes": [
		{
			"pattern": "api.harune.me",
			"custom_domain": true
		}
	],
	"compatibility_flags": ["nodejs_compat"],
	"triggers": {
		"crons": ["5 * * * *"]
	},
	"secrets": {
		"required": [
			"BETTER_AUTH_SECRET",
			"GOOGLE_CLIENT_ID",
			"GOOGLE_CLIENT_SECRET",
			"R2_ACCESS_KEY_ID",
			"R2_SECRET_ACCESS_KEY",
			"UPSTASH_REDIS_REST_TOKEN",
			"DODO_PAYMENTS_API_KEY",
			"DODO_PAYMENTS_WEBHOOK_SECRET"
		]
	},
	"placement": {
		"mode": "smart"
		// "region": "aws:ap-northeast-2",
	},
	"hyperdrive": [
		{
			"binding": "HYPERDRIVE",
			"id": "cf2cd4db500f4cd981219bd01b7d3a93"
		}
	],
	"r2_buckets": [
		{
			"binding": "PROFILE_MEDIA_BUCKET",
			"bucket_name": "umbrella",
			"remote": true
		}
	]
}
